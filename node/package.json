{
  "name": "emurestapi-examples",
  "version": "1.0.0",
  "private": true,
  "description": "Examples for Axiell's EMu REST API, in TypeScript",
  "license": "MIT",
  "author": "Field Museum of Natural History",
  "main": "dist/index.js",
  "keywords": [
    "emu",
    "axiell",
    "rest-api",
    "museum",
    "collections"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "example": "ts-node src/index.ts",
    "test": "jest",
    "test:integration": "jest -c jest.integration.config.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "eslint": "^10.0.0",
    "jest": "^29.0.0",
    "jest-util": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "dotenv": "^16.0.0"
  }
}
