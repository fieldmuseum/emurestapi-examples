# Base URL of your EMu REST API, with no trailing slash.
EMUAPI_URL="https://emu.example.com"

# Port the API listens on. Leave this empty if it is served on the default port.
EMUAPI_PORT="8080"

# Tenant is the EMu machine name for your institution.
EMUAPI_TENANT="mymuseum"

# Credentials for the token examples. Only the integration tests need these;
# the default test run mocks the HTTP layer and ignores them.
EMUAPI_USER="username"
EMUAPI_PASSWORD="password"

# Optional. The record the retrieve integration test reads. Defaults to 1,
# which may well not exist in your tenant.
EMUAPI_TEST_IRN="1"
