{
    "name": "emurestapi/examples",
    "description": "Examples for Axiell's EMu REST API, in PHP",
    "license": "MIT",
    "keywords": ["emu", "axiell", "rest-api", "museum", "collections"],
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "pestphp/pest": "^3.7"
    },
    "autoload": {
        "psr-4": {"EMuRestApi\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --exclude-group=integration",
        "test:integration": "pest --group=integration",
        "test:all": "pest",
        "lint": "pint --test",
        "lint:fix": "pint"
    },
    "config": {
        "vendor-dir": "vendor",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
